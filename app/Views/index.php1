                <li><a href="http://hecarse.com/Infos/" target="_blank"> Infos </a></li>
            </ul>
            <div class="menu-toggle" id="menuToggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Sección Inicial -->
    <section class="hero" id="inicio">
        <div class="hero-content">
            <div class="hero-tag">Agroinversiones Hecarse SAS</div>
            <h1>Líderes en Cultivo y Ganadería Sostenible</h1>
            <p>Combinamos tecnología de vanguardia con prácticas sostenibles para el cultivo de palma en tierras
                santandereanas</p>
            <a href="#contacto" class="cta-button">Contáctenos</a>
        </div>
    </section>

    <!-- Sección Productos -->
    <section class="products" id="productos">
        <div class="section-header">
            <div class="section-tag">Nuestros Productos</div>
        </div>
        <div class="products-grid">
            <div class="product-card">
                <!-- <div class="product-image">🌴</div> -->
                <div class="product-image"> <img src="public/assets/img/fondo_landing.png"> </div>
                <div class="product-content">
                    <h3>Cultivo de Palma Africana</h3>
                    <p>Producción especializada en palma de aceite.</p>
                </div>
            </div>
            <div class="product-card">
                <!-- <div class="product-image">🐄</div> -->
                <div class="product-image"> <img src="public/assets/img/ganaderia.png"> </div>
                <div class="product-content">
                    <h3>Ganadería Comercial</h3>
                    <p>Cría y manejo responsable de ganado.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Sección sobre nosotros -->
    <section class="about" id="nosotros">
        <div class="about-container">
            <div class="about-content">
                <div class="section-tag">Sobre Nosotros</div>
                <h2>Comprometidos con el Desarrollo del Sector Agroindustrial</h2>
                <p>Somos una empresa agroindustrial colombiana con experiencia en el cultivo de palma africana,
                    productos oleaginosos y servicios agropecuarios.</p>
                <p>Nuestro enfoque combina sostenibilidad, tecnología y excelencia operatvia para ofrecer soluciones
                    integrales en el campo.</p>
                <div class="about-stats">
                    <div class="stat-box">
                        <span class="stat-number">10+</span>
                        <span class="stat-label">Años de Experiencia</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-number">100%</span>
                        <span class="stat-label">Sostenible</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-number">100+</span>
                        <span class="stat-label">Empleados</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Soporte Continuo</span>
                    </div>
                </div>
            </div>
            <div class="about-image"></div>
        </div>
    </section>

    <!-- Sección Valores -->
    <section class="values" id="valores">
        <div class="section-header">
            <div class="section-tag">Nuestros Valores</div>
            <h2>Los principios que guían nuestras acciones</h2>
            <p>Cada decisión empresarial está fundamentada en valores sólidos que garantizan excelencia y
                responsabilidad</p>
        </div>
        <div class="values-grid">
            <div class="value-card">
                <span class="value-icon">🌱</span>
                <h3>Sostenibilidad</h3>
                <p>Actuamos con responsabilidad ambiental y social, asegurando que cada proceso contribuya al cuidado de
                    los ecosistemas y el bienestar de las comunidades.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">⭐</span>
                <h3>Calidad</h3>
                <p>Estamos comprometidos con la excelencia en cada etapa de la producción, garantizando productos que
                    cumplen los más altos estándares del sector.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">💡</span>
                <h3>Innovación</h3>
                <p>Promovemos la mejora continua y la adopción de nuevas tecnologías que optimicen la eficiencia,
                    sostenibilidad y competitividad de nuestra operación.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">🤝</span>
                <h3>Transparencia</h3>
                <p>Construimos confianza con nuestros colaboradores, clientes y comunidades a través de la comunicación
                    clara y la gestión ética de nuestras operaciones.</p>
            </div>
        </div>
    </section>

    <!-- Sección Contacto -->
    <section class="contact" id="contacto">
        <div class="contact-container">
            <div class="contact-info">
                <div class="section-tag">Contacto</div>
                <h2>Estamos aquí para responder sus preguntas</h2>

                <div class="info-item">
                    <div class="info-icon">📍</div>
                    <div class="info-text">
                        <h4> Dirección </h4>
                        <p> VDA El Cerrito Hacienda El Cruceiro </p>
                        <p> Sabana de Torres </p>
                        <p> Santander </p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📧</div>
                    <div class="info-text">
                        <h4>Email</h4>
                        <p>info@hecarse.com</p>
                        <p>contacto@hecarse.com</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📱</div>
                    <div class="info-text">
                        <h4> Teléfono </h4>
                        <p> 316 3718066 </p>
                    </div>
                </div>
            </div>

            <div class="contact-form">
                <form id="contactForm" action="javascript:void(0)" method="POST">
                    <div class="form-group">
                        <label for="name">Nombre Completo</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Correo Electrónico</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <!-- <div class="form-group">
                        <label for="subject">Asunto</label>
                        <select id="subject" name="subject" required>
                            <option value="">Seleccione un asunto</option>
                            <option value="proveedores">Futuros Proveedores</option>
                            <option value="empleo">Oportunidades de Trabajo</option>
                            <option value="comercial">Consulta Comercial</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div> -->
                    <div class="form-group">
                        <label for="message">Mensaje</label>
                        <textarea id="message" name="message" required></textarea>
                    </div>
                    <button type="submit" class="submit-btn">Enviar Mensaje</button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <p> Agroinversiones Hecarse S.A.S </p>
                <p> Comprometidos con el desarrollo sostenible del agronegocio colombiano.</p>
            </div>
            <div class="footer-section">
                <h4>Enlaces Rápidos</h4>
                <ul>
                    <li><a href="#inicio">Inicio</a></li>
                    <li><a href="#productos">Productos</a></li>
                    <li><a href="#nosotros">Nosotros</a></li>
                    <li><a href="#valores">Valores</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Servicios</h4>
                <ul>
                    <li><a href="#servicios">Producción Agrícola</a></li>
                    <li><a href="#servicios">Consultoría</a></li>
                    <li><a href="#servicios">Tecnología</a></li>
                    <li><a href="#servicios">Comercio Internacional</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Legal</h4>
                <ul>
                    <li><a href="#">Términos y Condiciones</a></li>
                    <li><a href="#">Política de Privacidad</a></li>
                    <li><a href="#">Política Ambiental</a></li>
                </ul>
            </div>
